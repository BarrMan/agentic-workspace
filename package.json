{
  "name": "agentic-workspace",
  "version": "1.53.0",
  "type": "module",
  "module": "src/cli/index.ts",
  "files": [
    "scripts/*.cjs",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "agentic-workspace": "scripts/cli.cjs"
  },
  "optionalDependencies": {
    "agentic-workspace-darwin-arm64": "*",
    "agentic-workspace-darwin-x64": "*",
    "agentic-workspace-linux-arm64": "*",
    "agentic-workspace-linux-x64": "*",
    "agentic-workspace-windows-arm64": "*",
    "agentic-workspace-windows-x64": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@clack/core": "1.4.3",
    "@clack/prompts": "1.7.0",
    "@types/bun": "1.3.14",
    "commander": "15.0.0",
    "fallow": "3.30.0",
    "fallow-type-aware": "3.30.0",
    "gray-matter": "4.0.3",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "picocolors": "1.1.1",
    "proper-lockfile": "4.1.2",
    "typescript": "7.0.2"
  },
  "scripts": {
    "test": "bun test --parallel --timeout=10000",
    "test:local": "bun test --parallel --max-concurrency=4 --timeout=10000",
    "benchmark:task-loading": "bun scripts/benchmark-task-loading.ts",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "check": "biome check .",
    "check:fallow": "fallow dead-code --type-aware --baseline .fallow-baseline.json && fallow dupes --baseline .fallow-dupes-baseline.json && fallow health --min-score 75",
    "check:types": "bunx tsc --noEmit",
    "prepare": "husky",
    "build": "bun scripts/build.ts",
    "cli": "bun src/cli/index.ts",
    "update-nix": "bunx bun2nix@2.1.1 -o bun.nix"
  },
  "lint-staged": {
    "package.json": [
      "biome check --write --files-ignore-unknown=true"
    ],
    "*.json": [
      "biome check --write --files-ignore-unknown=true --no-errors-on-unmatched"
    ],
    "src/**/*.{ts,tsx,js}": [
      "biome check --write --files-ignore-unknown=true"
    ]
  },
  "author": "Imri Barr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BarrMan/agentic-workspace.git"
  },
  "bugs": {
    "url": "https://github.com/BarrMan/agentic-workspace/issues"
  },
  "homepage": "https://github.com/BarrMan/agentic-workspace",
  "description": "AgenticWorkspace - Project management CLI",
  "keywords": [
    "cli",
    "markdown",
    "kanban",
    "task",
    "project-management",
    "backlog",
    "agents"
  ],
  "license": "MIT",
  "trustedDependencies": [
    "@biomejs/biome",
    "node-pty"
  ],
  "dependencies": {
    "@3leaps/sysprims": "0.2.4",
    "@opentui/core": "^0.5.14",
    "@opentui/keymap": "0.5.14",
    "libtmux": "^0.1.0-alpha.12",
    "zod": "^4.6.7"
  }
}
